# DirectLine Console Sample — Configuration
#
# Copy this file to .env and fill in the token endpoint URL.
# The token endpoint is found in Copilot Studio under:
#   Manage → Channels → Azure Bot Service → copy the token endpoint URL
#
# Format: https://{env}.environment.api.powerplatform.com/powervirtualagents/botsbyschema/{bot}/directline/token?api-version=2022-03-01-preview

DIRECTLINE_TOKEN_ENDPOINT=""

# Transport mode: "websocket" (default) or "polling"
# DIRECTLINE_TRANSPORT=websocket
